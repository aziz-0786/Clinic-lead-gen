# Copy real values with: vercel env pull .env
# Prisma CLI (migrate/generate) only auto-loads `.env`, not `.env.local` —
# use a single `.env` file locally so `npm run dev`/`build` and direct
# `npx prisma ...` commands see the same values.

# Neon Postgres, injected by the Vercel <-> Neon integration.
# DATABASE_URL is the pooled connection (used by the app at runtime).
# DATABASE_URL_UNPOOLED is the direct connection (required by Prisma
# Migrate — Neon's pooler can't run the DDL/advisory locks migrations need).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

APP_URL="http://localhost:3000"

# Optional: pins the dashboard to one clinic when multiple businesses exist
# in the database. Leave unset locally to use the first seeded business.
# BUSINESS_SLUG="smile-dental-raipur"

# Optional: SMTP for real email alerts
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourapp.com
